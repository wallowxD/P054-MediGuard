{"openapi": "3.1.0", "info": {"title": "Medication Safety Copilot", "description": "AI Agent tra tương tác thuốc–thuốc và thuốc–thực phẩm có nguồn. Thông tin tham khảo, không thay thế quyết định của bác sĩ.", "version": "0.1.0"}, "paths": {"/api/v1/auth/register": {"post": {"tags": ["auth"], "summary": "Đăng ký tài khoản bệnh nhân", "description": "Tạo tài khoản mới và trả về hồ sơ, KHÔNG trả token.\n\nĐăng ký xong client phải gọi tiếp `POST /auth/login` để đăng nhập. Tách hai bước để\nluồng đăng nhập chỉ có một đường đi duy nhất — cũng là chỗ sau này gắn xác thực email\nmà không phải đổi contract.", "operationId": "register_api_v1_auth_register_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/RegisterRequest"}}}, "required": true}, "responses": {"201": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuthUserResponse"}}}}, "400": {"description": "Mật khẩu không đạt yêu cầu", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}, "409": {"description": "Email đã được đăng ký", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/auth/login": {"post": {"tags": ["auth"], "summary": "Đăng nhập bằng email và mật khẩu", "description": "Trả cặp token kèm hồ sơ user, để client không phải gọi thêm `/auth/profiles`.", "operationId": "login_api_v1_auth_login_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginRequest"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginResponse"}}}}, "401": {"description": "Sai email hoặc mật khẩu", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}, "403": {"description": "Tài khoản bị vô hiệu hoá", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/auth/google": {"post": {"tags": ["auth"], "summary": "Đăng nhập bằng Google OpenID Connect", "description": "Verify Google ID Token, tìm hoặc tạo user tương ứng, rồi trả cặp token hệ thống.\n\nCùng response contract với `/auth/login` — client không cần phân biệt hai luồng sau khi\nđăng nhập xong. Không tự động liên kết khi email trùng local account chưa link, xem\n`GoogleAccountConflictError` và ADR 0016.", "operationId": "login_google_api_v1_auth_google_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/GoogleLoginRequest"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginResponse"}}}}, "401": {"description": "Google ID token không hợp lệ, hết hạn, hoặc email chưa xác thực", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}, "409": {"description": "Email đã có tài khoản nhưng chưa liên kết Google", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/auth/refresh": {"post": {"tags": ["auth"], "summary": "Làm mới cặp token bằng refresh token", "description": "Chỉ nhận token loại `refresh`.\n\nAccess token gửi vào đây bị từ chối 401: refresh token sống 14 ngày còn access token\nsống 30 phút, chấp nhận nhầm loại là kéo dài vòng đời token bị lộ lên gấp hàng trăm\nlần. Kiểm tra nằm ở `domain.auth.decode_token(expected_type=...)`.", "operationId": "refresh_api_v1_auth_refresh_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/RefreshRequest"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenPairResponse"}}}}, "401": {"description": "Refresh token hỏng hoặc hết hạn", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}, "403": {"description": "Tài khoản bị vô hiệu hoá", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/auth/profiles": {"get": {"tags": ["auth"], "summary": "Hồ sơ của user đang đăng nhập", "operationId": "get_profile_api_v1_auth_profiles_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuthUserResponse"}}}}, "401": {"description": "Unauthorized", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}}, "security": [{"HTTPBearer": []}]}}, "/api/v1/drugs": {"get": {"tags": ["drugs"], "summary": "List Drugs", "description": "Duyệt danh mục thuốc theo chữ cái, có phân trang.\n\nKhác `/drugs/search`: endpoint này lọc TẤT ĐỊNH bằng chuỗi con, không chấm điểm khớp\nmờ — người dùng đang duyệt danh mục nên phải thấy đúng nội dung bảng `drugs`.", "operationId": "list_drugs_api_v1_drugs_get", "parameters": [{"name": "letter", "in": "query", "required": false, "schema": {"anyOf": [{"type": "string", "pattern": "^([A-Za-z]|other)$"}, {"type": "null"}], "description": "Lọc theo chữ cái đầu của tên biệt dược: \"A\"–\"Z\", hoặc \"other\" cho tên không bắt đầu bằng chữ cái", "title": "Letter"}, "description": "Lọc theo chữ cái đầu của tên biệt dược: \"A\"–\"Z\", hoặc \"other\" cho tên không bắt đầu bằng chữ cái"}, {"name": "q", "in": "query", "required": false, "schema": {"anyOf": [{"type": "string", "maxLength": 200}, {"type": "null"}], "description": "Lọc chuỗi con trên tên biệt dược hoặc hoạt chất", "title": "Q"}, "description": "Lọc chuỗi con trên tên biệt dược hoặc hoạt chất"}, {"name": "page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "description": "Số trang, bắt đầu từ 1", "default": 1, "title": "Page"}, "description": "Số trang, bắt đầu từ 1"}, {"name": "pageSize", "in": "query", "required": false, "schema": {"type": "integer", "maximum": 100, "minimum": 1, "description": "Số dòng mỗi trang", "default": 40, "title": "Pagesize"}, "description": "Số dòng mỗi trang"}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DrugListResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/drugs/letters": {"get": {"tags": ["drugs"], "summary": "List Drug Letters", "description": "Đếm số thuốc theo từng chữ cái để dựng thanh A–Z.\n\n⚠️ Route tĩnh phải khai báo TRƯỚC `/{drug_id}` khi endpoint chi tiết được thêm vào,\nnếu không \"letters\" sẽ bị bắt như một drug_id và trả 404/422.", "operationId": "list_drug_letters_api_v1_drugs_letters_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DrugLetterIndexResponse"}}}}}}}, "/api/v1/drugs/search": {"get": {"tags": ["drugs"], "summary": "Search Drugs", "description": "Tra cứu danh mục thuốc qua `DrugRepository` và `domain/normalization.py`.\n\nƯu tiên khớp tên biệt dược: gõ một ký tự đã phải ra danh sách gợi ý, vì đây là ô\nautocomplete chứ không phải nút submit.", "operationId": "search_drugs_api_v1_drugs_search_get", "parameters": [{"name": "q", "in": "query", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 200, "description": "Từ khoá tên biệt dược hoặc hoạt chất", "title": "Q"}, "description": "Từ khoá tên biệt dược hoặc hoạt chất"}, {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "maximum": 20, "minimum": 1, "description": "Số lượng ứng viên tối đa trả về", "default": 10, "title": "Limit"}, "description": "Số lượng ứng viên tối đa trả về"}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DrugSearchResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/diseases": {"get": {"tags": ["diseases"], "summary": "Search Diseases", "operationId": "search_diseases_api_v1_diseases_get", "security": [{"HTTPBearer": []}], "parameters": [{"name": "q", "in": "query", "required": false, "schema": {"type": "string", "maxLength": 200, "default": "", "title": "Q"}}, {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "maximum": 20, "minimum": 1, "default": 10, "title": "Limit"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DiseaseSearchResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/patients/me/health-profile": {"get": {"tags": ["health-profile"], "summary": "Get Health Profile", "operationId": "get_health_profile_api_v1_patients_me_health_profile_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthProfileResponse"}}}}}, "security": [{"HTTPBearer": []}]}, "put": {"tags": ["health-profile"], "summary": "Put Health Profile", "operationId": "put_health_profile_api_v1_patients_me_health_profile_put", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthProfileUpdate"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthProfileResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}, "security": [{"HTTPBearer": []}]}}, "/api/v1/patients/me/conditions": {"post": {"tags": ["health-profile"], "summary": "Add Condition", "operationId": "add_condition_api_v1_patients_me_conditions_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/PatientConditionCreate"}}}, "required": true}, "responses": {"201": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PatientConditionResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}, "security": [{"HTTPBearer": []}]}}, "/api/v1/patients/me/conditions/{condition_id}": {"delete": {"tags": ["health-profile"], "summary": "Delete Condition", "operationId": "delete_condition_api_v1_patients_me_conditions__condition_id__delete", "security": [{"HTTPBearer": []}], "parameters": [{"name": "condition_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Condition Id"}}], "responses": {"204": {"description": "Successful Response"}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/patients/me/diseases": {"post": {"tags": ["health-profile"], "summary": "Add Disease", "operationId": "add_disease_api_v1_patients_me_diseases_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/PatientDiseaseCreate"}}}, "required": true}, "responses": {"201": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PatientDiseaseResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}, "security": [{"HTTPBearer": []}]}}, "/api/v1/patients/me/diseases/{patient_disease_id}": {"delete": {"tags": ["health-profile"], "summary": "Delete Disease", "operationId": "delete_disease_api_v1_patients_me_diseases__patient_disease_id__delete", "security": [{"HTTPBearer": []}], "parameters": [{"name": "patient_disease_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Patient Disease Id"}}], "responses": {"204": {"description": "Successful Response"}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/interactions/check": {"post": {"tags": ["interactions"], "summary": "Check Interactions", "operationId": "check_interactions_api_v1_interactions_check_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/InteractionCheckRequest"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InteractionCheckResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}, "security": [{"HTTPBearer": []}]}}, "/api/v1/interaction-checks": {"get": {"tags": ["interaction-history"], "summary": "List Checks", "operationId": "list_checks_api_v1_interaction_checks_get", "security": [{"HTTPBearer": []}], "parameters": [{"name": "page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "default": 1, "title": "Page"}}, {"name": "pageSize", "in": "query", "required": false, "schema": {"type": "integer", "maximum": 100, "minimum": 1, "default": 20, "title": "Pagesize"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InteractionCheckListResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}, "delete": {"tags": ["interaction-history"], "summary": "Clear Checks", "operationId": "clear_checks_api_v1_interaction_checks_delete", "security": [{"HTTPBearer": []}], "responses": {"204": {"description": "Successful Response"}}}}, "/api/v1/interaction-checks/{check_id}": {"get": {"tags": ["interaction-history"], "summary": "Get Check", "operationId": "get_check_api_v1_interaction_checks__check_id__get", "security": [{"HTTPBearer": []}], "parameters": [{"name": "check_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Check Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InteractionCheckResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}, "delete": {"tags": ["interaction-history"], "summary": "Delete Check", "operationId": "delete_check_api_v1_interaction_checks__check_id__delete", "security": [{"HTTPBearer": []}], "parameters": [{"name": "check_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Check Id"}}], "responses": {"204": {"description": "Successful Response"}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/prescriptions/extract": {"post": {"tags": ["prescription-extraction"], "summary": "Extract Prescription Images", "description": "Ảnh chỉ sống trong request; Gemini output vẫn phải được người dùng xác nhận với catalog.", "operationId": "extract_prescription_images_api_v1_prescriptions_extract_post", "requestBody": {"content": {"multipart/form-data": {"schema": {"$ref": "#/components/schemas/Body_extract_prescription_images_api_v1_prescriptions_extract_post"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PrescriptionExtractionResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}, "security": [{"HTTPBearer": []}]}}, "/api/v1/status": {"get": {"tags": ["system"], "summary": "Status", "operationId": "status_api_v1_status_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": {"type": "string"}, "type": "object", "title": "Response Status Api V1 Status Get"}}}}}}}, "/health": {"get": {"tags": ["system"], "summary": "Health", "operationId": "health_health_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": {"type": "string"}, "type": "object", "title": "Response Health Health Get"}}}}}}}}, "components": {"schemas": {"AISummary": {"properties": {"status": {"type": "string", "enum": ["generated", "fallback"], "title": "Status"}, "warning": {"type": "string", "title": "Warning"}, "managementBullets": {"items": {"type": "string"}, "type": "array", "title": "Managementbullets", "default": []}}, "type": "object", "required": ["status", "warning"], "title": "AISummary"}, "AuthUserResponse": {"properties": {"id": {"type": "string", "format": "uuid", "title": "Id"}, "email": {"type": "string", "format": "email", "title": "Email"}, "name": {"type": "string", "title": "Name"}, "roles": {"items": {"type": "string"}, "type": "array", "title": "Roles"}}, "type": "object", "required": ["id", "email", "name", "roles"], "title": "AuthUserResponse", "description": "Khớp `IAuthUser`. Tuyệt đối không thêm `password_hash` vào đây."}, "Body_extract_prescription_images_api_v1_prescriptions_extract_post": {"properties": {"images": {"items": {"type": "string", "contentMediaType": "application/octet-stream"}, "type": "array", "title": "Images", "description": "1–5 ảnh JPG, PNG hoặc WEBP của cùng một đơn thuốc"}}, "type": "object", "required": ["images"], "title": "Body_extract_prescription_images_api_v1_prescriptions_extract_post"}, "Citation": {"properties": {"evidenceId": {"type": "string", "title": "Evidenceid"}, "chunkId": {"anyOf": [{"type": "string", "format": "uuid"}, {"type": "null"}], "title": "Chunkid"}, "quote": {"type": "string", "title": "Quote"}, "source": {"type": "string", "title": "Source"}, "sourceUrl": {"type": "string", "title": "Sourceurl"}, "page": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Page"}, "section": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Section"}}, "type": "object", "required": ["evidenceId", "quote", "source", "sourceUrl"], "title": "Citation"}, "DiseaseResponse": {"properties": {"id": {"type": "string", "format": "uuid", "title": "Id"}, "name": {"type": "string", "title": "Name"}}, "type": "object", "required": ["id", "name"], "title": "DiseaseResponse"}, "DiseaseSearchResponse": {"properties": {"items": {"items": {"$ref": "#/components/schemas/DiseaseResponse"}, "type": "array", "title": "Items"}}, "type": "object", "required": ["items"], "title": "DiseaseSearchResponse"}, "DiseaseSnapshot": {"properties": {"id": {"type": "string", "format": "uuid", "title": "Id"}, "name": {"type": "string", "title": "Name"}}, "type": "object", "required": ["id", "name"], "title": "DiseaseSnapshot"}, "DrugCandidate": {"properties": {"drugId": {"type": "string", "title": "Drugid"}, "brandName": {"type": "string", "title": "Brandname"}, "ingredient": {"type": "string",