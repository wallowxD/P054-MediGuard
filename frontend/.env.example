# Frontend env — copy thành frontend/.env.local
#
# ⚠️ Đây là file RIÊNG của frontend. Secret của backend vẫn nằm ở .env repo root.
# ⚠️ Biến NEXT_PUBLIC_* bị NHÚNG CỨNG vào bundle lúc build → đổi giá trị là phải
#    build lại. Trong Docker phải truyền qua build.args, không phải environment.
#    Secret KHÔNG BAO GIỜ đặt tiền tố NEXT_PUBLIC_.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development

# Backend FastAPI — cổng 8000 (xem Makefile: make run / make dev)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Google Identity Services — PHẢI khớp GOOGLE_OAUTH_CLIENT_ID ở backend .env (ADR 0016).
# Không phải secret (client ID công khai trong OAuth consent screen) nhưng vẫn NEXT_PUBLIC_
# vì browser cần đọc để khởi tạo GIS. Tạo ở Google Cloud Console → Credentials → OAuth
# client ID → Web application, Authorized JavaScript origins = NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# NextAuth (sinh secret: openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
