# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
GOOGLE_API_KEY=your-gemini-key-here
DASHSCOPE_API_KEY=your-model-studio-key-here
# Use the workspace-specific Singapore Model Studio compatible-mode base URL.
# Example shape: https://WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=

# ---- Database ----
DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# Supabase Storage is used only by the ingestion adapter for private raw OCR artifacts.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# ---- Vector Store ----
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=ai20k_YOUR_PERSONAL_KEY_HERE
AI_LOG_DIR=.ai-log

# ---- Frontend ----
# Used by docker compose for the frontend service. Generate with:
#   openssl rand -base64 32
# Without this, next-auth throws NO_SECRET and redirects every route to /signin,
# including the public landing page.
NEXTAUTH_SECRET=

# NEXT_PUBLIC_* variables are baked into the bundle at BUILD time, so they live in
# docker-compose.yml under build.args, not here. For local `make web`, set them in
# frontend/.env.local instead (see frontend/.env.example).
