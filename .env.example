# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
GOOGLE_API_KEY=your-gemini-key-here
DASHSCOPE_API_KEY=your-model-studio-key-here
# Use the workspace-specific Singapore Model Studio compatible-mode base URL.
# Example shape: https://WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=

# ---- OCR Configuration ----
OCR_PROVIDER=gemini  # 'gemini' or 'qwen'

# Gemini / Vertex AI OCR Configuration
GEMINI_API_KEY=your-gemini-api-key-here
VERTEX_API_KEY=your-vertex-api-key-here
USE_VERTEX_AI=true
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Qwen OCR Configuration
QWEN_API_KEY=your-qwen-api-key-here
QWEN_MODEL=qwen3-vl-flash
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
OCR_DPI=300
OUTPUT_DIR=output

# ---- Database ----
# THIS FILE IS COMMITTED. Put the real connection string in .env, never here.
#
# Supabase → Project Settings → Database → Connection string.
# Pick "Session pooler" (port 5432), not "Transaction pooler" (port 6543): the API is a
# long-lived server, and the transaction pooler drops prepared-statement support.
# Then replace the `postgresql://` prefix with `postgresql+psycopg://` and paste your
# database password over [YOUR-PASSWORD]. Resulting shape:
#   postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-N-REGION.pooler.supabase.com:5432/postgres
# Percent-encode any reserved character in the password, e.g. `@` -> `%40`, `:` -> `%3A`,
# `/` -> `%2F`. An unencoded `@` splits the URI in the wrong place and psycopg reports a
# host that does not exist instead of a bad password.
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Same value in Docker: compose no longer ships a local `db` service, so the container
# talks to the exact same Supabase instance as `make dev`. Run `make migrate` from the
# host, not from inside the container.

# ---- Auth ----
# Signs the access/refresh JWTs issued by POST /api/v1/auth/{login,refresh,google}.
# Generate with: openssl rand -hex 32
# Rotating this value invalidates every issued token, i.e. logs everyone out.
JWT_SECRET_KEY=

# OAuth client ID from Google Cloud Console, used as the `audience` when verifying the
# Google ID Token in POST /api/v1/auth/google (ADR 0016). Not a secret, but differs per
# environment (dev/staging/production each need their own OAuth client).
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Supabase Storage is used only by the ingestion adapter for private raw OCR artifacts.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# ---- Vector Store ----
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=ai20k_YOUR_PERSONAL_KEY_HERE
AI_LOG_DIR=.ai-log

# ============================================
# ---- Frontend (Next.js) ----
# ============================================
# This is the ONLY env file in the project. Do NOT create frontend/.env or
# frontend/.env.local: Next.js reads those FIRST, so they silently override everything
# below. frontend/load-root-env.ts prints a warning if it finds one.
#
# How these reach the frontend:
#   make dev  -> frontend/next.config.ts imports frontend/load-root-env.ts, which reads
#                this file and injects ONLY keys prefixed NEXT_PUBLIC_ / NEXTAUTH_.
#                The backend secrets above never enter the Next.js process.
#   Docker    -> build context is ./frontend, so this file is NOT visible there.
#                docker-compose reads it to substitute ${...} into build.args.
#
# ⚠️ NEXT_PUBLIC_* is inlined into the bundle at BUILD time. Changing a value means
#    rebuilding (`make up` already passes --build). With `make dev` a restart is enough.
# ⚠️ NEVER prefix a secret with NEXT_PUBLIC_ — the browser can read it.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Browser-side Google Identity Services. MUST match GOOGLE_OAUTH_CLIENT_ID above.
# Google Cloud Console -> Credentials -> OAuth client ID -> Web application; the
# "Authorized JavaScript origins" list must contain exactly NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Backend URL for code running INSIDE the Next.js server process (the NextAuth
# `authorize()` callback). Leave EMPTY for `make dev` — Next and FastAPI both run on the
# host there, so NEXT_PUBLIC_API_BASE_URL above is already correct and this falls back to
# it. Docker sets it to http://backend:8000 via docker-compose.yml; inside a container
# `localhost:8000` points at the frontend container itself, not the backend.
API_INTERNAL_URL=

# next-auth server-side secret. Generate with: openssl rand -base64 32
# Without this, next-auth throws NO_SECRET and redirects every route to /signin,
# including the public landing page.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ============================================
# ---- VPS deployment (see docs/deployment.md) ----
# ============================================
# Everything above is the LOCAL profile. On the VPS the file name stays `.env`; only
# the values change. Replace the block below and the six variables it lists.
#
# Architecture: one domain, Caddy splits by path.
#   https://DOMAIN/          -> frontend:3000
#   https://DOMAIN/api/v1/*  -> backend:8000
# Same origin for browser and API, so no CORS preflight and a single TLS certificate.
#
#   PUBLIC_DOMAIN=medsafe.example.com     # DNS A record must already point at the VPS
#   ACME_EMAIL=you@example.com            # Let's Encrypt expiry notices
#   BIND_HOST=127.0.0.1                   # keep 3000/8000 off the public Internet
#
#   APP_ENV=production
#   NEXT_PUBLIC_ENVIRONMENT=production
#   NEXT_PUBLIC_APP_URL=https://medsafe.example.com
#   NEXT_PUBLIC_API_BASE_URL=https://medsafe.example.com   # same origin, NOT :8000
#   NEXTAUTH_URL=https://medsafe.example.com
#   CORS_ORIGINS=https://medsafe.example.com
#
# Also update in Google Cloud Console -> Credentials -> your OAuth client:
#   Authorized JavaScript origins: https://medsafe.example.com
# Google Identity Services refuses any non-HTTPS origin other than localhost, so the
# sign-in button cannot work on a bare http://IP:3000 deployment.

# Only read by docker-compose.prod.yml (Caddy). Leave empty for local development.
PUBLIC_DOMAIN=
ACME_EMAIL=
# Host interface the published ports bind to. Empty -> 0.0.0.0 (local default).
BIND_HOST=
