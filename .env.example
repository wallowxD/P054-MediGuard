# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
GOOGLE_API_KEY=your-gemini-key-here
DASHSCOPE_API_KEY=your-model-studio-key-here
# Use the workspace-specific Singapore Model Studio compatible-mode base URL.
# Example shape: https://WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=

# ---- OCR Configuration ----
OCR_PROVIDER=gemini  # 'gemini' or 'qwen'

# Gemini OCR Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Qwen OCR Configuration
QWEN_API_KEY=your-qwen-api-key-here
QWEN_MODEL=qwen3-vl-flash
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
OCR_DPI=300
OUTPUT_DIR=output

# ---- Database ----
# THIS FILE IS COMMITTED. Put the real connection string in .env, never here.
#
# Supabase → Project Settings → Database → Connection string.
# Pick "Session pooler" (port 5432), not "Transaction pooler" (port 6543): the API is a
# long-lived server, and the transaction pooler drops prepared-statement support.
# Then replace the `postgresql://` prefix with `postgresql+psycopg://` and paste your
# database password over [YOUR-PASSWORD]. Resulting shape:
#   postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-N-REGION.pooler.supabase.com:5432/postgres
# Percent-encode any reserved character in the password, e.g. `@` -> `%40`, `:` -> `%3A`,
# `/` -> `%2F`. An unencoded `@` splits the URI in the wrong place and psycopg reports a
# host that does not exist instead of a bad password.
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# For local Docker Compose (see docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://medsafe:medsafe@db:5432/medsafe

# ---- Auth ----
# Signs the access/refresh JWTs issued by POST /api/v1/auth/tokens.
# Generate with: openssl rand -hex 32
# Rotating this value invalidates every issued token, i.e. logs everyone out.
JWT_SECRET_KEY=

# Supabase Storage is used only by the ingestion adapter for private raw OCR artifacts.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# ---- Vector Store ----
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=ai20k_YOUR_PERSONAL_KEY_HERE
AI_LOG_DIR=.ai-log

# ---- Frontend ----
# Used by docker compose for the frontend service. Generate with:
#   openssl rand -base64 32
# Without this, next-auth throws NO_SECRET and redirects every route to /signin,
# including the public landing page.
NEXTAUTH_SECRET=

# NEXT_PUBLIC_* variables are baked into the bundle at BUILD time, so they live in
# docker-compose.yml under build.args, not here. For local `make web`, set them in
# frontend/.env.local instead (see frontend/.env.example).
