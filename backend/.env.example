# CẢNH BÁO: file .env THẬT phải nằm ở REPO ROOT, không phải ở backend/.
#   scripts/submit_log.py gọi load_dotenv() theo CWD = repo root.
#   Đặt .env ở backend/ sẽ làm hỏng submit AI log mà KHÔNG báo lỗi.
# File này chỉ để tra cứu tên biến. Copy giá trị sang <repo-root>/.env

# Model providers
OPENAI_API_KEY=sk-your-key-here
GOOGLE_API_KEY=your-gemini-key-here
DASHSCOPE_API_KEY=your-model-studio-key-here
DASHSCOPE_BASE_URL=
MODEL_NAME=gpt-4o
LLM_TEMPERATURE=0.0

# App
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+psycopg://medsafe:medsafe@localhost:5432/medsafe

# Auth — xem ADR 0015 và ADR 0016
# JWT_SECRET_KEY ký access/refresh token của /auth/login, /auth/refresh, /auth/google.
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=
# Client ID Google Cloud, dùng làm audience khi verify ID token ở POST /auth/google.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Managed data services
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# AI logging (BTC cấp qua link mời — mỗi thành viên một key riêng)
AI_LOG_API_KEY=your-personal-key
